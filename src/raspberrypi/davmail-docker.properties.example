# Copy the working Exchange mode, authentication and URL from the Mac installation.
davmail.server=true
davmail.enableTray=false
davmail.mode=ExchangeEWS
davmail.authentication=
davmail.url=https://exchange.example.test/EWS/Exchange.asmx

davmail.allowRemote=true
davmail.bindAddress=0.0.0.0
davmail.caldavPort=1080
davmail.imapPort=1143
davmail.smtpPort=1025
davmail.popPort=
davmail.ldapPort=

davmail.ssl.clientKeystoreType=PKCS12
davmail.ssl.clientKeystoreFile=/run/secrets/client.p12
davmail.ssl.clientKeystorePass=
davmail.ssl.clientKeystorePassFile=/run/secrets/client-p12-password
davmail.ssl.clientCertificateAlias=

davmail.ssl.keystoreType=PKCS12
davmail.ssl.keystoreFile=/run/secrets/server.p12
davmail.ssl.keystorePass=
davmail.ssl.keystorePassFile=/run/secrets/server-p12-password
davmail.ssl.keyPass=
davmail.ssl.keyPassFile=/run/secrets/server-p12-password
davmail.ssl.nosecurecaldav=false
davmail.ssl.nosecureimap=false
davmail.ssl.nosecuresmtp=false

davmail.disableUpdateCheck=true
davmail.logFilePath=/config/davmail.log
davmail.logFileSize=1MB
log4j.logger.davmail=INFO
log4j.logger.httpclient.wire=WARN
log4j.logger.httpclient=WARN
log4j.rootLogger=WARN
